hwguiGTK4.hbc

-hblib

-olib/hwgui

-hbx=hwgui.hbx

-w3

# Uncomment these two lines to build HwGUI in Unicode mode
-prgflag=-DUNICODE
-cflag=-DUNICODE
#
-cflag=-DHWG_USE_POINTER_ITEM
"{unix}-cflag=`pkg-config --cflags gtk4`"

@hwguiGTK4.hbm

# ============== EOF of hwguiGTK4.hbp ====================

