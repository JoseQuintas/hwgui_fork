# svg.hbc - librsvg support for HWGui (CLANG64 / MSYS2)

cflags=-D__USE_LIBRSVG -I/msys64/clang64/include/librsvg-2.0 -I/msys64/clang64/include/gdk-pixbuf-2.0 -I/msys64/clang64/include/webp -DLIBDEFLATE_DLL -I/msys64/clang64/include/cairo -I/msys64/clang64/include/libxml2 -I/msys64/clang64/include/pango-1.0 -I/msys64/clang64/include/fribidi -I/msys64/clang64/include/pixman-1 -I/msys64/clang64/include/harfbuzz -I/msys64/clang64/include/freetype2 -I/msys64/clang64/include/libpng16 -I/msys64/clang64/include/glib-2.0 -I/msys64/clang64/lib/glib-2.0/include

ldflags=-L/msys64/clang64/lib
libs=rsvg-2 gdk_pixbuf-2.0 gio-2.0 cairo gobject-2.0 glib-2.0 intl

